{
  "name": "willitfit",
  "version": "3.0.0",
  "private": true,
  "description": "WillItFit — Know Before You Go. Free cabin baggage size-checker.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "verify": "npm run type-check && npm run lint && npm test && npm run build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:dry-run": "opennextjs-cloudflare build && wrangler deploy --dry-run",
    "validate-build-content": "node archive/workbook-automation/content-automation/validate-build-content.mjs",
    "validate:content": "npm run validate-build-content",
    "check-airline-policies": "node archive/workbook-automation/content-automation/check-airline-policies.mjs",
    "check:airlines": "npm run check-airline-policies",
    "export-runtime": "node archive/workbook-automation/content-automation/export-runtime.mjs",
    "publisher:dry-run": "node scripts/rc6-publisher/run.mjs --mode=dry-run",
    "publisher:rc6:dry-run": "node scripts/rc6-publisher/run.mjs --mode=dry-run",
    "publisher:rc5:dry-run": "node scripts/rc5-publisher/run.mjs --mode=dry-run",
    "publishing:semantic-cert": "node scripts/publishing/certify-rule-semantics.mjs",
    "publishing:snapshots": "npm run publishing:semantic-cert && npm run publishing:zero-sheets-cert && node scripts/publishing/generate-snapshots-v2.mjs",
    "publishing:package-release": "node scripts/publishing/package-release-snapshots.mjs",
    "publishing:zero-sheets-cert": "node scripts/publishing/certify-zero-public-sheets.mjs",
    "publishing:owner-archive": "node scripts/publishing/create-owner-release-archive.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "next": "^15.5.18",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.106.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
