# Local WillItFly RC1 proof only. Copy to .env.local (gitignored).
# Keep Runtime pointed at the controlled WillItFly RC1 Runtime workbook.
WILLITFLY_RUNTIME_SPREADSHEET_ID=
WILLITFLY_RUNTIME_PREVIEW=true

# Read-only service-account credentials for the WillItFly Runtime.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Articles remain unpublished unless explicitly enabled.
WILLITFLY_ENABLE_ARTICLES=false
