# Local runtime proof only. Copy to .env.local (which is gitignored).
# Keep the runtime ID pointed at the TEST runtime workbook for local work.
GOOGLE_SHEETS_SPREADSHEET_ID=1pi8u7ddOaBeC9plEzh-TDck3pvVhw9mQg1Q24E7K4yU

# The build never connects to Authoritative Mother.
# Ask WillItFit submissions use private intake rows in Runtime; Cockpit/Pi owns governed Mother reconciliation.

# Service-account credentials need the Runtime permissions required by the build.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

SHEET_REVALIDATE_SECONDS=60
ENABLE_DIAGNOSTICS=true
