# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://will-it-fit.net
NEXT_PUBLIC_SITE_NAME=WillItFit

# ── Publishing snapshots ─────────────────────────────
# WillIt-owned publication origin used by airport/reference/live publishing pages.
# Live aviation MUST arrive here through the collector -> validation -> snapshot pipeline.
# Do not point this at Google Sheets, airport/airline APIs or comparator APIs.
# If omitted, publishing reads snapshot paths from NEXT_PUBLIC_SITE_URL.
WILLIT_SNAPSHOT_BASE_URL=

# ── Google Sheets (TOOLS / governed Runtime only) ───
# Runtime is the tool-facing data layer. It is not used by the live aviation publishing chain.
# Current production Runtime. RC6 Draft code must not fall back to this value.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Isolated RC6 Draft Runtime. Required only for RC6 Draft/certification consumers.
RC6_RUNTIME_SPREADSHEET_ID=
# Mother receives private Ask WillItFit submissions for moderation.
# The service account must have write access to Mother.
GOOGLE_SHEETS_MOTHER_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key, keeping \n escape sequences intact.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Analytics (structure only — not wired up in MVP) ─
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Revalidation ─────────────────────────────────────
# Seconds between background re-fetches of TOOL Runtime sheet data.
SHEET_REVALIDATE_SECONDS=3600

# Existing diagnostics are disabled in production unless explicitly enabled.
ENABLE_DIAGNOSTICS=false
# RC6 Draft reconciliation endpoint is independently fail-closed.
RC6_DRAFT_DIAGNOSTICS_ENABLED=false
# RC6 commercial/page preview is independently fail-closed and non-indexable.
RC6_DRAFT_COMMERCIAL_ENABLED=false
