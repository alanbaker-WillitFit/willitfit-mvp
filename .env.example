# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=WillItFly

# ── WillItFly Runtime ────────────────────────────────
# Approved site-facing Runtime spreadsheet.
WILLITFLY_RUNTIME_SPREADSHEET_ID=
# Preview allows reviewed/draft RC1 Runtime rows during controlled development only.
WILLITFLY_RUNTIME_PREVIEW=false

# ── Google service account (read only) ──────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key locally, keeping \n escape sequences intact.
# Never commit a real private key.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Optional capabilities ────────────────────────────
# Articles remain in code but are unpublished unless explicitly enabled.
WILLITFLY_ENABLE_ARTICLES=false
